rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Put your admin email(s) here, in lowercase, matching config.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['your-email@example.com'];
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Each student's profile, summary and daily activity
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid);
      allow delete: if isAdmin();
    }

    // Each student's full progress
    match /progress/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isSelf(uid);
    }

    // Shared settings such as video links: everyone signed in reads, only admins write
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
